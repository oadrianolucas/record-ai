{
  "manifest_version": 3,
  "name": "RECORD-AI Voice Recorder",
  "version": "3.0.0",
  "description": "Grave áudio e envie para sua API RECORD-AI — token seguro no servidor.",
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}