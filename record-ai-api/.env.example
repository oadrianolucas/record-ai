# Copie para .env e preencha
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Conversa padrão (usada quando o cliente não envia HASH_ID)
TELEGRAM_CHAT_ID=123456789
# Alias público da conversa padrão — a extensão usa este valor, nunca o chat_id real.
# Use um identificador aleatório (ex: uuid) e troque quando quiser, sem mexer no chat_id.
HASH_ID=troque-por-um-hash-aleatorio
# Conversas adicionais no mesmo bot — pares TELEGRAM_CHAT_ID_N + HASH_ID_N (_1, _2, ...)
# O webhook aceita áudio de qualquer uma; a extensão escolhe via campo "HASH ID"
TELEGRAM_CHAT_ID_1=987654321
HASH_ID_1=outro-hash-aleatorio
# TELEGRAM_CHAT_ID_2=456789123
# HASH_ID_2=mais-um-hash-aleatorio
RECORD-AI_API_KEY=sua-chave-secreta-aqui
ENABLE_TRANSCRIPTION=false
WHISPER_MODEL_SIZE=small
TELEGRAM_WEBHOOK_SECRET=seu-token-secreto-para-webhook
HF_TOKEN=seu-token-do-hugging-face

# DeepSeek (organização/resumo da reunião)
DEEPSEEK_API_KEY=sua-chave-deepseek

# Notion (criação automática de páginas)
NOTION_API_KEY=ntn_xxx
NOTION_PARENT_PAGE_ID=xxx  # opcional: cria páginas dentro desta página
